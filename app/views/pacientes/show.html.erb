<turbo-frame id="paciente_body">

<p style="color: green"><%= notice %></p>

<%= form_with url: paciente_path(@paciente), method: :get, data: { turbo_frame: 'paciente_body' } do |f| %>
  <div class="form-check form-switch">
    <%= f.check_box :todos, { checked: params[:todos] == "1", onchange: "this.form.requestSubmit()", class: "form-check-input" }, "1", "0" %>
    <%= f.label :todos, 'Mostrar todos', class: "form-check-label" %>
  </div>
<% end %>

<%= render @paciente %>

<div class="form-actions">
  <div class="row row-cols-auto">
    <div class="col">
      <%= link_to "Editar", edit_paciente_path(@paciente), class: "btn btn-primary" %> 
    </div>
    <div class="col">
      <%= button_to "Excluir", @paciente, form: { data: { turbo_confirm: "Você tem certeza que deseja excluir?" } }, method: :delete,  class: "btn btn-danger" unless @paciente.agendas.count > 0 %>
    </div>
    <div class="col">
      <%= link_to "Novo", new_paciente_path, class: "btn btn-success" %> 
    </div>
    <div class="col">
      <%= link_to "Voltar", pacientes_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>
</div>
</turbo-frame>