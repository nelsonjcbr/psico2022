<p style="color: green"><%= notice %></p>

<h1>Agendas</h1>

<div class="row">
  <div class="col">
    <%= link_to "Novo", new_agenda_path, class: "btn btn-success" %>
  </div>
  <div class="col">
      <%= form_with url: agendas_path, method: :get do |f| %>
      <%= f.text_field :cmpt, value: params[:cmpt], class: "form-control form-control-sm", placeholder: "Competência aaaamm, informe 0 para listar todas" %>
    <% end %>
  </div>
</div>

<div class="row">
  <div class=col-md-3>
    <%= "Atendidos Sim(#{@total_atendidos})/Não(#{@total_nao_atendidos})" %>
  </div>
  <div class=col-md-3>
    <%= "Total R$ #{@total_valor_atendidos}" %>
  </div>
  <div class=col-md-3>
    <%= "Recebido: #{@total_valor_recebido}" %>
  </div>
  <div class=col-md-3>
    <%= link_to "Lista", "agendas/index/lista?cmpt=#{params[:cmpt]}"  %>
  </div>

</div>

<% if params[:cmpt] == '0' %>
  <div class="alert alert-info mt-3" role="alert">
    Selecione uma competência (formato aaaamm) para visualizar a agenda.
  </div>
<% else %>
  <div class="row g-1 fw-bold text-center mb-1">
    <div class="col">Seg</div>
    <div class="col">Ter</div>
    <div class="col">Qua</div>
    <div class="col">Qui</div>
    <div class="col">Sex</div>
    <div class="col">Sáb</div>
  </div>

  <% @weeks.each do |week| %>
    <div class="row g-1 mb-1">
      <% week.each do |cell| %>
        <% day = cell[:date] %>
        <% in_month = day.month == params[:cmpt][4..5].to_i %>
        <div class="col border <%= 'bg-light' if cell[:agendas].empty? %>" style="min-height: 110px;">
          <% if day.wday == 1 %>
            <div class="badge bg-secondary">
          <% end %>
          <% if day.wday == 2 %>
            <div class="badge bg-dark">
          <% end %>
          <% if day.wday == 3 %>
            <div class="badge bg-info">
          <% end %>
          <% if day.wday == 4 %>
            <div class="badge bg-success" style="--bs-bg-opacity: .7;">
          <% end %>
          <% if day.wday == 5 %>
            <div class="badge bg-success">
          <% end %>
          <% if day.wday == 6 %>
            <div class="badge bg-warning" style="--bs-bg-opacity: .9;">
          <% end %>
            <b class="<%= 'text-muted' unless in_month %>"><%= day.strftime('%d/%m') %></b>
          </div>
          <% cell[:agendas].each do |agenda| %>
            <div <%= raw 'class="text-decoration-line-through"' if agenda.cancelado %>>
              <small class="bi-alarm"><%= link_to "#{agenda.data_hora.hour}:#{format('%02d', agenda.data_hora.min)}", agenda_path(agenda) %></small>
              <small><%= agenda.paciente.nome_chamado %></small>
              <% if agenda.agendado %>
                <span class="badge bg-danger">Agendado</span>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>

<div class="row">
  <div class="col">
    <%= link_to "Novo", new_agenda_path, class: "btn btn-success" %>
  </div>
</div>

