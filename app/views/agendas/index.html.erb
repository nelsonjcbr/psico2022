<p style="color: green"><%= notice %></p>

<% meses = %w[Janeiro Fevereiro Março Abril Maio Junho Julho Agosto Setembro Outubro Novembro Dezembro] %>
<% if params[:cmpt] != '0' %>
  <% ref = Date.new(params[:cmpt][0..3].to_i, params[:cmpt][4..5].to_i, 1) %>
  <% cmpt_anterior = (ref << 1).strftime('%Y%m') %>
  <% cmpt_proxima = (ref >> 1).strftime('%Y%m') %>
<% end %>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-2 mb-3">
  <div class="d-flex align-items-center gap-2">
    <% if ref %>
      <%= link_to agendas_path(cmpt: cmpt_anterior), class: "btn btn-outline-secondary btn-sm", title: "Mês anterior" do %>
        <i class="bi-chevron-left"></i>
      <% end %>
    <% end %>
    <h1 class="h3 mb-0">
      Agenda
      <% if ref %>
        <small class="text-muted fw-normal">&middot; <%= "#{meses[ref.month - 1]} #{ref.year}" %></small>
      <% else %>
        <small class="text-muted fw-normal">&middot; Todas</small>
      <% end %>
    </h1>
    <% if ref %>
      <%= link_to agendas_path(cmpt: cmpt_proxima), class: "btn btn-outline-secondary btn-sm", title: "Próximo mês" do %>
        <i class="bi-chevron-right"></i>
      <% end %>
    <% end %>
  </div>

  <div class="d-flex flex-wrap align-items-center gap-2">
    <%= form_with url: agendas_path, method: :get, class: "d-flex" do |f| %>
      <%= f.text_field :cmpt, value: params[:cmpt], class: "form-control form-control-sm", style: "width: 14rem;", placeholder: "Competência aaaamm (0 = todas)" %>
    <% end %>
    <%= link_to "agendas/index/lista?cmpt=#{params[:cmpt]}", class: "btn btn-outline-primary btn-sm" do %>
      <i class="bi-list-ul"></i> Lista
    <% end %>
    <%= link_to new_agenda_path, class: "btn btn-success btn-sm" do %>
      <i class="bi-plus-lg"></i> Novo
    <% end %>
  </div>
</div>

<div class="row g-2 mb-3">
  <div class="col-md-4">
    <div class="border rounded bg-white px-3 py-2 h-100">
      <div class="small text-muted">Atendidos</div>
      <div class="fs-5 fw-semibold">
        <span class="text-success"><%= @total_atendidos %></span> sim
        <span class="text-muted">/</span>
        <span class="text-danger"><%= @total_nao_atendidos %></span> não
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="border rounded bg-white px-3 py-2 h-100">
      <div class="small text-muted">Total atendido</div>
      <div class="fs-5 fw-semibold">R$ <%= @total_valor_atendidos %></div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="border rounded bg-white px-3 py-2 h-100">
      <div class="small text-muted">Recebido</div>
      <div class="fs-5 fw-semibold">R$ <%= @total_valor_recebido %></div>
    </div>
  </div>
</div>

<% if params[:cmpt] == '0' %>
  <div class="alert alert-info mt-3" role="alert">
    Selecione uma competência (formato aaaamm) para visualizar a agenda.
  </div>
<% else %>
  <div class="row g-1 fw-bold text-center text-uppercase small mb-1">
    <% %w[Seg Ter Qua Qui Sex Sáb].each do |dia| %>
      <div class="col">
        <div class="bg-secondary text-white rounded py-1"><%= dia %></div>
      </div>
    <% end %>
  </div>

  <% @weeks.each do |week| %>
    <div class="row g-1 mb-1">
      <% week.each do |cell| %>
        <% day = cell[:date] %>
        <% in_month = day.month == params[:cmpt][4..5].to_i %>
        <div class="col border <%= 'bg-light' if cell[:agendas].empty? %>" style="min-height: 110px;">
          <div class="badge <%= in_month ? 'bg-primary' : 'bg-light text-muted border' %>">
            <b class="<%= 'text-muted' unless in_month %>"><%= day.strftime('%d/%m') %></b>
          </div>
          <% cell[:agendas].each do |agenda| %>
            <div <%= raw 'class="text-decoration-line-through"' if agenda.cancelado %>>
              <small class="bi-alarm"><%= link_to "#{agenda.data_hora.hour}:#{format('%02d', agenda.data_hora.min)}", agenda_path(agenda) %></small>
              <small><%= agenda.paciente.nome_chamado %></small>
              <% if agenda.agendado %>
                <span class="badge bg-danger">Agendado</span>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>

<div class="row">
  <div class="col">
    <%= link_to "Novo", new_agenda_path, class: "btn btn-success" %>
  </div>
</div>

